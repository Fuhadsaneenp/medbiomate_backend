# Use a dedicated Medbiomate database. Never connect this project to Trikonet's database.
MEDBIOMATE_DB_HOST=127.0.0.1
MEDBIOMATE_DB_PORT=3306
MEDBIOMATE_DB_USER=medbiomate
MEDBIOMATE_DB_PASSWORD=
MEDBIOMATE_DB_NAME=medbiomate
CORS_ORIGIN=https://www.medbiomate.com,https://medbiomate.com
# Production must use MySQL sessions.
MEDBIOMATE_LOCAL_MODE=0
# Configure optional services with Medbiomate credentials only.
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
PASSWORD_RESET_FROM=
JOB_ALERT_API_ORIGIN=https://api.medbiomate.com
